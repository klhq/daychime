{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard", "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'small'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Small", "wrap": true },
        { "type": "TextBlock", "text": "${nowLabel} · ${now}", "isSubtle": true, "spacing": "None" },
        { "type": "TextBlock", "$when": "${clockedIn}", "text": "${finishLabel}", "isSubtle": true, "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${clockedIn}", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" },
        { "type": "TextBlock", "$when": "${clockedIn}", "text": "${clockInLabel}: ${clockIn}", "isSubtle": true, "spacing": "Small" },
        { "type": "TextBlock", "$when": "${!clockedIn}", "text": "${notClockedInYet}", "size": "Medium", "weight": "Bolder", "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${!clockedIn}", "text": "${breakSummary}", "isSubtle": true, "wrap": true, "spacing": "Small" }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'medium'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Medium", "wrap": true },
        { "type": "TextBlock", "text": "${nowLabel} · ${now}", "isSubtle": true, "spacing": "None" },
        { "type": "TextBlock", "text": "${breakSummary}", "isSubtle": true, "spacing": "None" },
        {
          "type": "ColumnSet",
          "$when": "${clockedIn}",
          "spacing": "Medium",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${clockInLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${clockIn}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] },
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${finishLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] }
          ]
        },
        {
          "type": "Container",
          "$when": "${!clockedIn}",
          "spacing": "Large",
          "items": [
            { "type": "TextBlock", "text": "${notClockedInYet}", "size": "Large", "weight": "Bolder" },
            { "type": "TextBlock", "text": "${clockInHint}", "isSubtle": true, "wrap": true, "spacing": "Small" }
          ]
        },
        { "type": "Input.Time", "$when": "${isEditing && !use24Hour}", "id": "clockIn", "label": "${editTime}", "value": "${clockInValue}", "spacing": "Medium", "separator": true },
        { "type": "Input.Text", "$when": "${isEditing && use24Hour}", "id": "clockIn", "label": "${editTime}", "placeholder": "09:00", "value": "${clockInValue}", "spacing": "Medium", "separator": true },
        { "type": "Input.Toggle", "$when": "${isEditing}", "id": "use24Hour", "title": "${use24HourLabel}", "value": "${use24Hour}", "valueOn": "true", "valueOff": "false", "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${confirmingClear}", "text": "${confirmClear}", "weight": "Bolder", "wrap": true, "spacing": "Medium" }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'large'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Large", "wrap": true },
        { "type": "TextBlock", "text": "${nowLabel} · ${now}", "isSubtle": true, "spacing": "None" },
        { "type": "TextBlock", "text": "${breakSummary}", "isSubtle": true, "spacing": "None" },
        {
          "type": "ColumnSet",
          "$when": "${clockedIn}",
          "spacing": "Large",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${clockInLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${clockIn}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] },
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${finishLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] }
          ]
        },
        {
          "type": "Container",
          "$when": "${!clockedIn}",
          "spacing": "ExtraLarge",
          "items": [
            { "type": "TextBlock", "text": "${notClockedInYet}", "size": "ExtraLarge", "weight": "Bolder" },
            { "type": "TextBlock", "text": "${clockInHint}", "isSubtle": true, "wrap": true, "spacing": "Small" }
          ]
        },
        { "type": "Input.Time", "$when": "${isEditing && !use24Hour}", "id": "clockIn", "label": "${editTime}", "value": "${clockInValue}", "spacing": "Large", "separator": true },
        { "type": "Input.Text", "$when": "${isEditing && use24Hour}", "id": "clockIn", "label": "${editTime}", "placeholder": "09:00", "value": "${clockInValue}", "spacing": "Large", "separator": true },
        { "type": "Input.Toggle", "$when": "${isEditing}", "id": "use24Hour", "title": "${use24HourLabel}", "value": "${use24Hour}", "valueOn": "true", "valueOff": "false", "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${confirmingClear}", "text": "${confirmClear}", "weight": "Bolder", "wrap": true, "spacing": "Large", "separator": true }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "$when": "${!clockedIn}", "title": "${clockInNow}", "verb": "clockIn" },
    { "type": "Action.Execute", "$when": "${canEdit && $host.widgetSize != 'small'}", "title": "${editTime}", "verb": "edit" },
    { "type": "Action.Execute", "$when": "${isEditing && $host.widgetSize != 'small'}", "title": "${saveChanges}", "verb": "saveTime" },
    { "type": "Action.Execute", "$when": "${isEditing && $host.widgetSize != 'small'}", "title": "${cancelEdit}", "verb": "cancelEdit" },
    { "type": "Action.Execute", "$when": "${canEdit && $host.widgetSize != 'small'}", "title": "${clear}", "verb": "askClear" },
    { "type": "Action.Execute", "$when": "${confirmingClear}", "title": "${clear}", "verb": "clear" },
    { "type": "Action.Execute", "$when": "${confirmingClear}", "title": "${cancel}", "verb": "cancelClear" }
  ]
}
