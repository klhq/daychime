{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container", "$when": "${$host.widgetSize == 'small'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Small", "wrap": true },
        { "type": "TextBlock", "$when": "${isWorkdayComplete}", "text": "✓ ${workdayComplete}", "weight": "Bolder", "color": "Good", "size": "Small", "spacing": "Small", "wrap": true },
        {
          "type": "ColumnSet", "$when": "${showFormatToggle}", "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center", "items": [ { "type": "TextBlock", "text": "${nowLabel} ${now}", "isSubtle": true, "size": "Small", "wrap": false } ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "Center", "selectAction": { "type": "Action.Execute", "verb": "toggleTimeFormat", "title": "${formatToggleTitle}" },
              "items": [ { "type": "TextBlock", "text": "${formatBadge}", "size": "Small", "weight": "Bolder", "color": "Accent", "wrap": false } ] }
          ]
        },
        { "type": "Container", "$when": "${showFormatToggle}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "cycleWorkHours", "title": "${workHoursToggleTitle}" },
          "items": [ { "type": "TextBlock", "text": "${workHoursSummary}", "size": "Small", "weight": "Bolder", "color": "Accent", "wrap": true } ] },
        { "type": "TextBlock", "$when": "${canEdit}", "text": "${finishLabel}", "isSubtle": true, "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${canEdit}", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" },
        { "type": "TextBlock", "$when": "${endsNextDay}", "text": "${endsTomorrow}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true },
        { "type": "TextBlock", "$when": "${canEdit}", "text": "${clockInLabel} ${clockIn}", "isSubtle": true, "spacing": "Small" },
        { "type": "TextBlock", "$when": "${timezoneChanged}", "text": "${timezoneAdjustedNote}", "isSubtle": true, "size": "Small", "wrap": true, "spacing": "Small" },
        { "type": "Container", "$when": "${canEdit}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "askClear", "title": "${clearLink}" },
          "items": [ { "type": "TextBlock", "text": "${clearLink}", "size": "Small", "color": "Attention", "wrap": true } ] },
        { "type": "TextBlock", "$when": "${!clockedIn}", "text": "${notClockedInYet}", "size": "Medium", "weight": "Bolder", "spacing": "Medium" },
        { "type": "TextBlock", "$when": "${!clockedIn}", "text": "${clockInHint}", "isSubtle": true, "wrap": true, "spacing": "Small" },
        { "type": "Container", "$when": "${!clockedIn && !isAutoSettings}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "configureAutoClockIn", "title": "${autoClockInToggleTitle}" },
          "items": [ { "type": "TextBlock", "text": "${autoClockInStatus}", "size": "Small", "color": "Accent", "wrap": true } ] },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInSettingsTitle}", "weight": "Bolder", "spacing": "Medium", "separator": true, "wrap": true },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInExplanation}", "isSubtle": true, "wrap": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isAutoSettings}", "id": "autoClockInAfter", "label": "${autoClockInAfterTitle}", "value": "${autoClockInAfter}", "isRequired": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isEditing && !use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Medium", "separator": true },
        { "type": "Input.Text", "$when": "${isEditing && use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "placeholder": "09:00", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Medium", "separator": true },
        { "type": "TextBlock", "$when": "${hasTimeError}", "text": "${invalidTime}", "color": "Attention", "wrap": true, "spacing": "Small" },
        { "type": "TextBlock", "$when": "${confirmingClear}", "text": "${confirmClear}", "weight": "Bolder", "wrap": true, "spacing": "Medium", "separator": true }
      ]
    },
    {
      "type": "Container", "$when": "${$host.widgetSize == 'medium'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Medium", "wrap": true },
        { "type": "TextBlock", "$when": "${isWorkdayComplete}", "text": "✓ ${workdayComplete}", "weight": "Bolder", "color": "Good", "size": "Small", "spacing": "Small", "wrap": true },
        {
          "type": "ColumnSet", "$when": "${showFormatToggle}", "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center", "items": [ { "type": "TextBlock", "text": "${nowLabel} ${now}", "isSubtle": true, "wrap": false } ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "Center", "selectAction": { "type": "Action.Execute", "verb": "toggleTimeFormat", "title": "${formatToggleTitle}" },
              "items": [ { "type": "TextBlock", "text": "${formatBadge}", "weight": "Bolder", "color": "Accent", "wrap": false } ] }
          ]
        },
        { "type": "Container", "$when": "${showFormatToggle}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "cycleWorkHours", "title": "${workHoursToggleTitle}" },
          "items": [ { "type": "TextBlock", "text": "${workHoursSummary}", "size": "Small", "weight": "Bolder", "color": "Accent", "wrap": true } ] },
        {
          "type": "ColumnSet", "$when": "${canEdit}", "spacing": "Medium", "separator": true,
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${clockInLabel}", "isSubtle": true, "size": "Small" }, { "type": "TextBlock", "text": "${clockIn}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] },
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${finishLabel}", "isSubtle": true, "size": "Small" }, { "type": "TextBlock", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" }, { "type": "TextBlock", "$when": "${endsNextDay}", "text": "${endsTomorrow}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true } ] }
          ]
        },
        { "type": "TextBlock", "$when": "${timezoneChanged}", "text": "${timezoneAdjustedNote}", "isSubtle": true, "size": "Small", "wrap": true, "spacing": "Small" },
        { "type": "Container", "$when": "${canEdit}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "askClear", "title": "${clearLink}" },
          "items": [ { "type": "TextBlock", "text": "${clearLink}", "size": "Small", "color": "Attention", "wrap": true } ] },
        {
          "type": "Container", "$when": "${!clockedIn}", "spacing": "Large", "separator": true,
          "items": [
            { "type": "TextBlock", "text": "${notClockedInYet}", "size": "Large", "weight": "Bolder" },
            { "type": "TextBlock", "text": "${clockInHint}", "isSubtle": true, "wrap": true, "spacing": "Small" },
            { "type": "Container", "$when": "${!isAutoSettings}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "configureAutoClockIn", "title": "${autoClockInToggleTitle}" },
              "items": [ { "type": "TextBlock", "text": "${autoClockInStatus}", "size": "Small", "color": "Accent", "wrap": true } ] }
          ]
        },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInSettingsTitle}", "weight": "Bolder", "spacing": "Medium", "separator": true, "wrap": true },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInExplanation}", "isSubtle": true, "wrap": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isAutoSettings}", "id": "autoClockInAfter", "label": "${autoClockInAfterTitle}", "value": "${autoClockInAfter}", "isRequired": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isEditing && !use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Medium", "separator": true },
        { "type": "Input.Text", "$when": "${isEditing && use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "placeholder": "09:00", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Medium", "separator": true },
        { "type": "TextBlock", "$when": "${hasTimeError}", "text": "${invalidTime}", "color": "Attention", "wrap": true, "spacing": "Small" },
        { "type": "TextBlock", "$when": "${confirmingClear}", "text": "${confirmClear}", "weight": "Bolder", "wrap": true, "spacing": "Medium", "separator": true }
      ]
    },
    {
      "type": "Container", "$when": "${$host.widgetSize == 'large'}",
      "items": [
        { "type": "TextBlock", "text": "${date}", "weight": "Bolder", "size": "Large", "wrap": true },
        { "type": "TextBlock", "$when": "${isWorkdayComplete}", "text": "✓ ${workdayComplete}", "weight": "Bolder", "color": "Good", "size": "Small", "spacing": "Small", "wrap": true },
        {
          "type": "ColumnSet", "$when": "${showFormatToggle}", "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center", "items": [ { "type": "TextBlock", "text": "${nowLabel} ${now}", "isSubtle": true, "wrap": false } ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "Center", "selectAction": { "type": "Action.Execute", "verb": "toggleTimeFormat", "title": "${formatToggleTitle}" },
              "items": [ { "type": "TextBlock", "text": "${formatBadge}", "weight": "Bolder", "color": "Accent", "wrap": false } ] }
          ]
        },
        { "type": "Container", "$when": "${showFormatToggle}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "cycleWorkHours", "title": "${workHoursToggleTitle}" },
          "items": [ { "type": "TextBlock", "text": "${workHoursSummary}", "weight": "Bolder", "color": "Accent", "wrap": true } ] },
        {
          "type": "ColumnSet", "$when": "${canEdit}", "spacing": "Large", "separator": true,
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${clockInLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${clockIn}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" } ] },
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${finishLabel}", "isSubtle": true }, { "type": "TextBlock", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" }, { "type": "TextBlock", "$when": "${endsNextDay}", "text": "${endsTomorrow}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true } ] }
          ]
        },
        { "type": "TextBlock", "$when": "${timezoneChanged}", "text": "${timezoneAdjustedNote}", "isSubtle": true, "size": "Small", "wrap": true, "spacing": "Small" },
        { "type": "Container", "$when": "${canEdit}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "askClear", "title": "${clearLink}" },
          "items": [ { "type": "TextBlock", "text": "${clearLink}", "size": "Small", "color": "Attention", "wrap": true } ] },
        {
          "type": "Container", "$when": "${!clockedIn}", "spacing": "ExtraLarge", "separator": true,
          "items": [
            { "type": "TextBlock", "text": "${notClockedInYet}", "size": "ExtraLarge", "weight": "Bolder" },
            { "type": "TextBlock", "text": "${clockInHint}", "isSubtle": true, "wrap": true, "spacing": "Small" },
            { "type": "Container", "$when": "${!isAutoSettings}", "spacing": "Small", "selectAction": { "type": "Action.Execute", "verb": "configureAutoClockIn", "title": "${autoClockInToggleTitle}" },
              "items": [ { "type": "TextBlock", "text": "${autoClockInStatus}", "color": "Accent", "wrap": true } ] }
          ]
        },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInSettingsTitle}", "weight": "Bolder", "spacing": "Large", "separator": true, "wrap": true },
        { "type": "TextBlock", "$when": "${isAutoSettings}", "text": "${autoClockInExplanation}", "isSubtle": true, "wrap": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isAutoSettings}", "id": "autoClockInAfter", "label": "${autoClockInAfterTitle}", "value": "${autoClockInAfter}", "isRequired": true, "spacing": "Small" },
        { "type": "Input.Time", "$when": "${isEditing && !use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Large", "separator": true },
        { "type": "Input.Text", "$when": "${isEditing && use24Hour}", "id": "clockIn", "label": "${clockInTimeLabel}", "placeholder": "09:00", "value": "${clockInValue}", "isRequired": true, "errorMessage": "${invalidTime}", "spacing": "Large", "separator": true },
        { "type": "TextBlock", "$when": "${hasTimeError}", "text": "${invalidTime}", "color": "Attention", "wrap": true, "spacing": "Small" },
        { "type": "TextBlock", "$when": "${confirmingClear}", "text": "${confirmClear}", "weight": "Bolder", "wrap": true, "spacing": "Large", "separator": true }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "$when": "${(!clockedIn || isWorkdayComplete) && !isEditing && !confirmingClear && !isAutoSettings}", "title": "${clockInActionTitle}", "verb": "clockIn", "style": "positive" },
    { "type": "Action.Execute", "$when": "${canEdit}", "title": "✎  ${editTime}", "verb": "edit" },
    { "type": "Action.Execute", "$when": "${isEditing}", "title": "${saveChanges}", "verb": "saveTime", "style": "positive" },
    { "type": "Action.Execute", "$when": "${isEditing}", "title": "${cancelEdit}", "verb": "cancelEdit" },
    { "type": "Action.Execute", "$when": "${isAutoSettings}", "title": "${autoClockInPrimaryAction}", "verb": "saveAutoClockIn", "style": "positive" },
    { "type": "Action.Execute", "$when": "${isAutoSettings && autoClockInEnabled}", "title": "${turnOffAutoClockIn}", "verb": "turnOffAutoClockIn", "style": "destructive" },
    { "type": "Action.Execute", "$when": "${isAutoSettings}", "title": "${cancel}", "verb": "cancelAutoClockIn" },
    { "type": "Action.Execute", "$when": "${confirmingClear}", "title": "×  ${clear}", "verb": "clear", "style": "destructive" },
    { "type": "Action.Execute", "$when": "${confirmingClear}", "title": "${cancel}", "verb": "cancelClear" }
  ]
}
