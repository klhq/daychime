{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$when": "${isAutoSettings}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Input.Text",
                  "id": "autoClockInAfter",
                  "value": "${autoClockInAfter}",
                  "label": "${autoAfterCompactLabel}",
                  "placeholder": "09:30",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Bottom",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "actions": [
                    {
                      "type": "Action.Execute",
                      "verb": "saveAutoClockIn",
                      "title": "${saveShort}",
                      "style": "positive"
                    },
                    {
                      "type": "Action.Execute",
                      "verb": "cancelAutoClockIn",
                      "title": "${cancel}",
                      "associatedInputs": "none"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${invalidTimeShort}",
          "spacing": "None",
          "wrap": true,
          "$when": "${hasAutoTimeError}",
          "size": "Small",
          "color": "Attention",
          "maxLines": 2
        },
        {
          "type": "Container",
          "$when": "${autoClockInEnabled && !hasAutoTimeError}",
          "spacing": "Small",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "turnOffAutoClockIn",
            "title": "${turnOffAutoClockIn}",
            "associatedInputs": "none"
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${turnOffAutoClockIn}",
              "spacing": "None",
              "wrap": false,
              "size": "Small",
              "color": "Accent"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${autoClockInExplanation}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${$host.widgetSize == 'large'}",
          "size": "Small",
          "isSubtle": true
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${isEditing}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "Input.Text",
                  "id": "clockIn",
                  "value": "${clockInValue}",
                  "label": "${clockInTimeCompactLabel}",
                  "placeholder": "09:30",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Bottom",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "actions": [
                    {
                      "type": "Action.Execute",
                      "verb": "saveTime",
                      "title": "${saveShort}",
                      "style": "positive"
                    },
                    {
                      "type": "Action.Execute",
                      "verb": "cancelEdit",
                      "title": "${cancel}",
                      "associatedInputs": "none"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${clockInTimeError}",
          "spacing": "None",
          "wrap": true,
          "$when": "${hasTimeError}",
          "size": "Small",
          "color": "Attention",
          "maxLines": 2
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${confirmingClear}",
      "spacing": "None",
      "items": [
        {
          "type": "TextBlock",
          "text": "${confirmClear}",
          "spacing": "None",
          "wrap": true,
          "weight": "Bolder",
          "maxLines": 2
        },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            {
              "type": "Action.Execute",
              "verb": "clear",
              "title": "${clear}",
              "style": "destructive",
              "associatedInputs": "none"
            },
            {
              "type": "Action.Execute",
              "verb": "cancelClear",
              "title": "${cancel}",
              "associatedInputs": "none"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${isOptions}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "cycleWorkHours",
                "title": "${workHoursToggleTitle}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${workHoursCompact}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "toggleTimeFormat",
                "title": "${formatToggleTitle}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${formatBadge}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "configureAutoClockIn",
                "title": "${autoClockInToggleTitle}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${autoClockInCompact}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "edit",
                "title": "${editTime}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${editShort}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ],
              "$when": "${clockedIn}"
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "askClear",
                "title": "${clearLink}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${clear}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ],
              "$when": "${clockedIn}"
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "clockIn",
                "title": "${clockInActionTitle}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${newShiftShort}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ],
              "$when": "${clockedIn && isWorkdayComplete}"
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "undoClockOut",
                "title": "${undoClockOutActionTitle}",
                "associatedInputs": "none"
              },
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${undoClockOutActionTitle}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "color": "Accent"
                }
              ],
              "$when": "${hasUndoableShift}"
            }
          ]
        },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            {
              "type": "Action.Execute",
              "verb": "closeOptions",
              "title": "${done}",
              "associatedInputs": "none"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${previousShiftSummary}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${hasPreviousShift && $host.widgetSize != 'small'}",
          "isSubtle": true,
          "size": "Small",
          "maxLines": 3
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showMain && $host.widgetSize == 'small'}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${clockInLabel}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${clockIn}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Medium",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${finishCaption}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${finishCompact}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Medium",
                  "weight": "Bolder"
                }
              ]
            }
          ],
          "$when": "${clockedIn && !needsAutoClockInTime}"
        },
        {
          "type": "TextBlock",
          "text": "${autoClockInMissingShort}",
          "spacing": "None",
          "wrap": false,
          "$when": "${needsAutoClockInTime}",
          "size": "Small",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${notClockedInYet}",
          "spacing": "None",
          "wrap": false,
          "$when": "${!clockedIn && !needsAutoClockInTime}",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${previousShiftCompact}",
          "spacing": "None",
          "wrap": false,
          "$when": "${!clockedIn && hasPreviousShift}",
          "size": "Small",
          "isSubtle": true
        },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            {
              "type": "Action.Execute",
              "verb": "clockOut",
              "title": "${clockOutActionTitle}",
              "$when": "${clockedIn && !needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "clockIn",
              "title": "${clockInNow}",
              "$when": "${!clockedIn || needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "showOptions",
              "title": "${more}",
              "associatedInputs": "none"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showMain && $host.widgetSize == 'medium'}",
      "spacing": "None",
      "items": [
        {
          "type": "TextBlock",
          "text": "${date}",
          "spacing": "None",
          "wrap": false,
          "size": "Small",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${nowLabel} ${now}",
          "spacing": "Small",
          "wrap": false,
          "size": "Small",
          "isSubtle": true
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${clockInLabel}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${clockIn}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Large",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${finishCaption}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${finishCompact}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Large",
                  "weight": "Bolder"
                }
              ]
            }
          ],
          "$when": "${clockedIn}"
        },
        {
          "type": "TextBlock",
          "text": "${notClockedInYet}",
          "spacing": "Small",
          "wrap": false,
          "$when": "${!clockedIn}",
          "size": "Medium",
          "weight": "Bolder"
        },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            {
              "type": "Action.Execute",
              "verb": "clockOut",
              "title": "${clockOutActionTitle}",
              "$when": "${clockedIn && !needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "clockIn",
              "title": "${clockInNow}",
              "$when": "${!clockedIn || needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "showOptions",
              "title": "${more}",
              "associatedInputs": "none"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${previousShiftSummary}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${hasPreviousShift}",
          "isSubtle": true,
          "size": "Small",
          "maxLines": 2
        },
        {
          "type": "TextBlock",
          "text": "${autoClockInMissing}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${needsAutoClockInTime}",
          "isSubtle": true,
          "size": "Small",
          "maxLines": 2
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${showMain && $host.widgetSize == 'large'}",
      "spacing": "None",
      "items": [
        {
          "type": "TextBlock",
          "text": "${date}",
          "spacing": "None",
          "wrap": false,
          "size": "Medium",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${nowLabel} ${now}",
          "spacing": "Small",
          "wrap": false,
          "size": "Small",
          "isSubtle": true
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${clockInLabel}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${clockIn}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "ExtraLarge",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${finishCaption}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "Small",
                  "isSubtle": true
                },
                {
                  "type": "TextBlock",
                  "text": "${finish}",
                  "spacing": "None",
                  "wrap": false,
                  "size": "ExtraLarge",
                  "weight": "Bolder"
                },
                {
                  "type": "TextBlock",
                  "$when": "${endsNextDay}",
                  "text": "${endsTomorrow}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": false
                }
              ]
            }
          ],
          "$when": "${clockedIn}"
        },
        {
          "type": "TextBlock",
          "text": "${workHoursSummary}",
          "spacing": "Small",
          "wrap": false,
          "$when": "${clockedIn}",
          "size": "Small",
          "isSubtle": true
        },
        {
          "type": "TextBlock",
          "text": "${notClockedInYet}",
          "spacing": "Small",
          "wrap": false,
          "$when": "${!clockedIn}",
          "size": "Medium",
          "weight": "Bolder"
        },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            {
              "type": "Action.Execute",
              "verb": "clockOut",
              "title": "${clockOutActionTitle}",
              "$when": "${clockedIn && !needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "clockIn",
              "title": "${clockInNow}",
              "$when": "${!clockedIn || needsAutoClockInTime}",
              "style": "positive"
            },
            {
              "type": "Action.Execute",
              "verb": "showOptions",
              "title": "${more}",
              "associatedInputs": "none"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${previousShiftSummary}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${hasPreviousShift}",
          "isSubtle": true,
          "size": "Small",
          "maxLines": 2
        },
        {
          "type": "TextBlock",
          "text": "${autoClockInMissing}",
          "spacing": "Small",
          "wrap": true,
          "$when": "${needsAutoClockInTime}",
          "isSubtle": true,
          "size": "Small",
          "maxLines": 2
        },
        {
          "type": "TextBlock",
          "text": "${autoClockInStatus}",
          "spacing": "Small",
          "wrap": false,
          "size": "Small",
          "isSubtle": true
        }
      ]
    }
  ]
}
