{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$when": "${view == 'main' && $host.widgetSize == 'small'}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "$when": "${showShift}", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None", "wrap": false },
                { "type": "TextBlock", "$when": "${!showShift}", "text": "${headline}", "size": "Large", "weight": "Bolder", "spacing": "None", "wrap": false },
                { "type": "TextBlock", "text": "${statusShort}", "size": "Small", "isSubtle": "${!isOvertime}", "color": "${if(isOvertime, 'Good', 'Default')}", "spacing": "None", "wrap": false }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "actions": [
                    { "type": "Action.Execute", "verb": "${primaryVerb}", "title": "${primaryShort}", "style": "positive", "associatedInputs": "none" }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "Image", "$when": "${showShift}", "url": "${if($host.hostTheme == 'dark', barDark, barLight)}", "altText": "${progressAlt}", "size": "Stretch", "height": "6px", "spacing": "Small" }
      ]
    },
    {
      "type": "Container",
      "$when": "${view == 'main' && $host.widgetSize != 'small'}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${date}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false } ] },
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${now}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false } ] }
          ]
        },
        {
          "type": "Container",
          "$when": "${showShift}",
          "spacing": "Medium",
          "items": [
            { "type": "TextBlock", "text": "${finishCaption}", "size": "Small", "isSubtle": "${!isOvertime}", "color": "${if(isOvertime, 'Good', 'Default')}", "spacing": "None", "wrap": false },
            {
              "type": "ColumnSet",
              "spacing": "None",
              "columns": [
                { "type": "Column", "width": "auto", "verticalContentAlignment": "Bottom", "items": [ { "type": "TextBlock", "text": "${finish}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None", "wrap": false } ] },
                { "type": "Column", "width": "stretch", "verticalContentAlignment": "Bottom", "items": [ { "type": "TextBlock", "text": "${remaining}", "size": "Medium", "horizontalAlignment": "Right", "color": "${if(isOvertime, 'Good', 'Default')}", "spacing": "None", "wrap": true, "maxLines": 2 } ] }
              ]
            },
            { "type": "Image", "url": "${if($host.hostTheme == 'dark', barDark, barLight)}", "altText": "${progressAlt}", "size": "Stretch", "height": "6px", "spacing": "Small" },
            {
              "type": "ColumnSet",
              "$when": "${$host.widgetSize == 'large'}",
              "spacing": "Medium",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    { "type": "TextBlock", "text": "${startCaption}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false },
                    { "type": "TextBlock", "text": "${startShort}", "size": "Medium", "weight": "Bolder", "spacing": "None", "wrap": false }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    { "type": "TextBlock", "text": "${workedCaption}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false },
                    { "type": "TextBlock", "text": "${workedShort}", "size": "Medium", "weight": "Bolder", "spacing": "None", "wrap": false }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    { "type": "TextBlock", "text": "${leftCaption}", "size": "Small", "isSubtle": "${!isOvertime}", "color": "${if(isOvertime, 'Good', 'Default')}", "spacing": "None", "wrap": false },
                    { "type": "TextBlock", "text": "${leftShort}", "size": "Medium", "weight": "Bolder", "color": "${if(isOvertime, 'Good', 'Default')}", "spacing": "None", "wrap": false }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "$when": "${$host.widgetSize == 'medium'}",
              "spacing": "Small",
              "columns": [
                { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${startedLine}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false } ] },
                {
                  "type": "Column",
                  "width": "auto",
                  "selectAction": { "type": "Action.Execute", "verb": "edit", "title": "${editTitle}", "associatedInputs": "none" },
                  "items": [ { "type": "TextBlock", "text": "${editShort}", "size": "Small", "color": "Accent", "spacing": "None", "wrap": false } ]
                }
              ]
            },
            { "type": "TextBlock", "$when": "${timezoneAdjusted}", "text": "${timezoneAdjustedNote}", "size": "Small", "isSubtle": true, "spacing": "Small", "wrap": true, "maxLines": 2 }
          ]
        },
        {
          "type": "Container",
          "$when": "${!showShift}",
          "spacing": "Medium",
          "items": [
            { "type": "TextBlock", "text": "${headline}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None", "wrap": false },
            { "type": "TextBlock", "text": "${statusLong}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true, "maxLines": 2 }
          ]
        },
        {
          "type": "ActionSet",
          "spacing": "Medium",
          "actions": [
            { "type": "Action.Execute", "verb": "${primaryVerb}", "title": "${primaryLong}", "style": "positive", "associatedInputs": "none" },
            { "type": "Action.Execute", "$when": "${showShift && $host.widgetSize == 'large'}", "verb": "edit", "title": "${editTitle}", "associatedInputs": "none" }
          ]
        },
        {
          "type": "Container",
          "$when": "${$host.widgetSize == 'large'}",
          "spacing": "ExtraLarge",
          "items": [
            { "type": "TextBlock", "$when": "${hasPrevious}", "text": "${previousCaption}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": false },
            { "type": "TextBlock", "$when": "${hasPrevious}", "text": "${previousLine}", "spacing": "None", "wrap": true, "maxLines": 2 },
            { "type": "TextBlock", "text": "${settingsCaption}", "size": "Small", "isSubtle": true, "spacing": "Medium", "wrap": false },
            { "type": "TextBlock", "text": "${settingsLine}", "spacing": "None", "wrap": true, "maxLines": 2 }
          ]
        },
        { "type": "TextBlock", "$when": "${$host.widgetSize == 'medium' && hasPrevious && !timezoneAdjusted}", "text": "${previousShort}", "size": "Small", "isSubtle": true, "spacing": "Medium", "wrap": false }
      ]
    },
    {
      "type": "Container",
      "$when": "${view == 'edit'}",
      "spacing": "None",
      "items": [
        { "type": "TextBlock", "$when": "${$host.widgetSize != 'small'}", "text": "${editTitle}", "weight": "Bolder", "spacing": "None", "wrap": false },
        { "type": "TextBlock", "$when": "${$host.widgetSize != 'small'}", "text": "${editHint}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true, "maxLines": 2 },
        { "type": "TextBlock", "$when": "${$host.widgetSize == 'small'}", "text": "${if(hasTimeError, clockInTimeError, editLabelShort)}", "size": "Small", "color": "${if(hasTimeError, 'Attention', 'Default')}", "spacing": "None", "wrap": false },
        {
          "type": "ColumnSet",
          "spacing": "${if($host.widgetSize == 'small', 'Small', 'Medium')}",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "Input.Text", "id": "clockIn", "value": "${clockInValue}", "label": "${if($host.widgetSize == 'small', '', editLabel)}", "placeholder": "09:30", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Bottom",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "actions": [
                    { "type": "Action.Execute", "verb": "saveTime", "title": "${save}", "style": "positive" },
                    { "type": "Action.Execute", "verb": "cancelEdit", "title": "${cancel}", "associatedInputs": "none" }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "TextBlock", "$when": "${hasTimeError && $host.widgetSize != 'small'}", "text": "${clockInTimeError}", "size": "Small", "color": "Attention", "spacing": "None", "wrap": true, "maxLines": 2 },
        {
          "type": "Container",
          "$when": "${$host.widgetSize != 'small'}",
          "spacing": "Large",
          "selectAction": { "type": "Action.Execute", "verb": "askClear", "title": "${clearTitle}", "associatedInputs": "none" },
          "items": [ { "type": "TextBlock", "text": "${clearTitle}", "size": "Small", "color": "Attention", "spacing": "None", "wrap": false } ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${view == 'confirmClear'}",
      "spacing": "None",
      "items": [
        { "type": "TextBlock", "text": "${confirmClear}", "weight": "Bolder", "spacing": "None", "wrap": true, "maxLines": 2 },
        { "type": "TextBlock", "$when": "${$host.widgetSize != 'small'}", "text": "${confirmClearHint}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true, "maxLines": 3 },
        {
          "type": "ActionSet",
          "spacing": "Small",
          "actions": [
            { "type": "Action.Execute", "verb": "clear", "title": "${clear}", "style": "destructive", "associatedInputs": "none" },
            { "type": "Action.Execute", "verb": "cancelClear", "title": "${cancel}", "associatedInputs": "none" }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${view == 'customize' && $host.widgetSize == 'small'}",
      "spacing": "None",
      "items": [
        { "type": "TextBlock", "text": "${customizeSmallHint}", "spacing": "None", "wrap": true, "maxLines": 2 },
        { "type": "ActionSet", "spacing": "Small", "actions": [ { "type": "Action.Execute", "verb": "cancelCustomization", "title": "${done}", "style": "positive", "associatedInputs": "none" } ] }
      ]
    },
    {
      "type": "Container",
      "$when": "${view == 'customize' && $host.widgetSize != 'small'}",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "Input.ChoiceSet", "id": "workHours", "label": "${workHoursLabel}", "style": "compact", "value": "${workHoursValue}", "choices": [ { "$data": "${workHoursChoices}", "title": "${title}", "value": "${value}" } ] }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "Input.ChoiceSet", "id": "timeFormat", "label": "${timeFormatLabel}", "style": "compact", "value": "${timeFormatValue}", "choices": [ { "$data": "${timeFormatChoices}", "title": "${title}", "value": "${value}" } ] }
              ]
            }
          ]
        },
        { "type": "Input.Toggle", "id": "autoClockIn", "title": "${autoToggleTitle}", "value": "${autoValue}", "valueOn": "true", "valueOff": "false", "wrap": true, "spacing": "Medium" },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [ { "type": "Input.Text", "id": "autoClockInAfter", "label": "${autoAfterLabel}", "value": "${autoAfterValue}", "placeholder": "06:00", "spacing": "None" } ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Bottom",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "actions": [
                    { "type": "Action.Execute", "verb": "saveCustomization", "title": "${done}", "style": "positive" },
                    { "type": "Action.Execute", "verb": "cancelCustomization", "title": "${cancel}", "associatedInputs": "none" }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "TextBlock", "$when": "${hasAutoTimeError}", "text": "${invalidTimeShort}", "size": "Small", "color": "Attention", "spacing": "None", "wrap": true, "maxLines": 2 },
        { "type": "TextBlock", "$when": "${$host.widgetSize == 'large'}", "text": "${autoClockInExplanation}", "size": "Small", "isSubtle": true, "spacing": "Medium", "wrap": true }
      ]
    }
  ]
}
